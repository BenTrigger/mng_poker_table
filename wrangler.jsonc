{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokertable",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "pokertable" }
  ],
  // Served at the custom domain (DNS record + certificate are created automatically
  // when realizeaisolution.com is a zone in the same Cloudflare account)
  "routes": [
    { "pattern": "pokertable.realizeaisolution.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
