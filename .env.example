# Supabase project (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: enables counting chips from photos (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# optional: model for counting stacks (default claude-opus-5-5, also used for learning a chip set)
CHIP_COUNT_MODEL=
