# Supabase project (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: enables counting chips from photos (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# optional: model for counting stacks (default claude-sonnet-5-5). Learning a chip set uses claude-opus-5-5.
CHIP_COUNT_MODEL=
